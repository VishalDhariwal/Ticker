{
  "name": "ticker-extension",
  "version": "1.0.0",
  "description": "Track your time effortlessly with a smart, draggable floating timer. 100% private, offline, and no account required.",
  "private": true,
  "scripts": {
    "dev": "vite build --watch & npx esbuild src/content/content.ts --bundle --outfile=dist/content/content.js --alias:@=./src --watch",
    "build": "vite build && npx esbuild src/content/content.ts --bundle --outfile=dist/content/content.js --alias:@=./src --minify",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.293",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-static-copy": "^2.0.0"
  },
  "type": "module"
}